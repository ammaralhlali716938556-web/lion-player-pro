<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="android:statusBarColor">@color/app_surface</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="bottomSheetStyle">@style/AppBottomSheetStyle</item>
    </style>

    <style name="AppBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
    </style>

    <!-- ================= Secure Vault ================= -->
    <!-- FLAG_SECURE is applied in code (window.addFlags) - this theme keeps the vault dark -->
    <style name="VaultTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vault_accent</item>
        <item name="colorPrimaryDark">@color/vault_accent_dark</item>
        <item name="colorAccent">@color/vault_accent</item>
        <item name="android:windowBackground">@color/vault_background</item>
        <item name="android:colorBackground">@color/vault_background</item>
        <item name="colorSurface">@color/vault_surface</item>
        <item name="android:statusBarColor">@color/vault_background</item>
        <item name="android:navigationBarColor">@color/vault_background</item>
        <item name="android:textColorPrimary">@color/vault_text</item>
        <item name="android:textColorSecondary">@color/vault_text_secondary</item>
    </style>

    <style name="VaultButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/vault_accent</item>
        <item name="android:textColor">#06121C</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VaultTextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/vault_text_secondary</item>
    </style>
</resources>
