<?xml version="1.0" encoding="utf-8"?>
<!-- Secure Vault lock screen. FLAG_SECURE is applied in VaultLockActivity.onCreate() -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vaultLockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_background">

    <ImageView
        android:id="@+id/ivVaultIcon"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:layout_marginTop="64dp"
        android:contentDescription="@string/vault_name"
        android:src="@drawable/ic_shield"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vault_accent" />

    <TextView
        android:id="@+id/tvLockTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/vault_lock_title"
        android:textColor="@color/vault_text"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivVaultIcon" />

    <TextView
        android:id="@+id/tvLockSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/vault_lock_subtitle"
        android:textColor="@color/vault_text_secondary"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvLockTitle" />

    <!-- PIN dots are generated at runtime -->
    <LinearLayout
        android:id="@+id/pinDotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLockSubtitle" />

    <EditText
        android:id="@+id/etPin"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_vault_input"
        android:cursorVisible="false"
        android:gravity="center"
        android:hint="@string/vault_pin_hint"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:letterSpacing="0.4"
        android:maxLength="8"
        android:textColor="@color/vault_text"
        android:textColorHint="@color/vault_text_secondary"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pinDotsContainer" />

    <TextView
        android:id="@+id/tvLockMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/vault_error"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/etPin" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_vault_button"
        android:text="@string/vault_unlock"
        android:textColor="#06121C"
        android:textStyle="bold"
        app:backgroundTint="@color/vault_accent"
        app:cornerRadius="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLockMessage" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBiometric"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="32dp"
        android:text="@string/vault_use_biometric"
        android:textColor="@color/vault_text"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_fingerprint"
        app:iconGravity="textStart"
        app:iconTint="@color/vault_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnUnlock"
        app:strokeColor="#33FFFFFF" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnForgotPin"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/vault_forgot_pin"
        android:textColor="@color/vault_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBiometric" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelLock"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text="إلغاء والعودة"
        android:textColor="@color/vault_text_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
